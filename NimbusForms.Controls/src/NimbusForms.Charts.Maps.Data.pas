var WorldShapes, CountryShapes: TArray<TNimbusMapShape>;
  Cities: TArray<TNimbusMapCity>; DataLock: TObject;

procedure EnsureLoaded;
var Builder: TStringBuilder; Compressed, Plain: TMemoryStream; Decoder: TDecompressionStream;
  Bytes: TBytes; K: Integer;
  NewWorld, NewCountries: TArray<TNimbusMapShape>; NewCities: TArray<TNimbusMapCity>;
  function ReadInteger: Integer;
  begin Plain.ReadBuffer(Result, SizeOf(Result)) end;
  function ReadString: string;
  var TextBytes: TBytes; LengthText: Integer;
  begin LengthText := ReadInteger; if (LengthText < 0) or (LengthText > Plain.Size - Plain.Position) then raise EReadError.Create('Invalid map string'); SetLength(TextBytes, LengthText); if LengthText > 0 then Plain.ReadBuffer(TextBytes[0], LengthText); Result := TEncoding.UTF8.GetString(TextBytes) end;
  procedure ReadShapes(out Shapes: TArray<TNimbusMapShape>);
  var Left, Top, Right, Bottom: Single; I, J, P, R, N: Integer; Shape: TNimbusMapShape; Point: TPointF;
  begin
    SetLength(Shapes, ReadInteger);
    for I := 0 to High(Shapes) do
    begin
      Shape := Default(TNimbusMapShape); Shape.Code := ReadString; Shape.Name := ReadString; Shape.Region := ReadString;
      Left := MaxSingle; Top := MaxSingle; Right := -MaxSingle; Bottom := -MaxSingle;
      SetLength(Shape.Polygons, ReadInteger);
      for P := 0 to High(Shape.Polygons) do
      begin
        SetLength(Shape.Polygons[P], ReadInteger);
        for R := 0 to High(Shape.Polygons[P]) do
        begin
          N := ReadInteger; SetLength(Shape.Polygons[P][R], N);
          for J := 0 to N - 1 do
          begin Plain.ReadBuffer(Point.X, SizeOf(Single)); Plain.ReadBuffer(Point.Y, SizeOf(Single)); Shape.Polygons[P][R][J] := Point;
            Left := Min(Left, Point.X); Top := Min(Top, Point.Y); Right := Max(Right, Point.X); Bottom := Max(Bottom, Point.Y) end;
        end;
      end;
      Shape.Bounds := TRectF.Create(Left, Top, Right, Bottom); Shapes[I] := Shape;
    end;
  end;
begin
  TMonitor.Enter(DataLock);
  try
    if Length(WorldShapes) > 0 then Exit;
    Builder := TStringBuilder.Create; Compressed := TMemoryStream.Create; Plain := TMemoryStream.Create;
    try
      for K := Low(MapData) to High(MapData) do Builder.Append(MapData[K]); Bytes := TNetEncoding.Base64.DecodeStringToBytes(Builder.ToString);
      if Length(Bytes) > 0 then Compressed.WriteBuffer(Bytes[0], Length(Bytes)); Compressed.Position := 0;
      Decoder := TDecompressionStream.Create(Compressed);
      try Plain.CopyFrom(Decoder, 0) finally Decoder.Free end; Plain.Position := 0;
      ReadShapes(NewWorld); ReadShapes(NewCountries); SetLength(NewCities, ReadInteger);
      for K := 0 to High(NewCities) do
      begin NewCities[K].Country := ReadString; NewCities[K].Name := ReadString; NewCities[K].Region := ReadString;
        Plain.ReadBuffer(NewCities[K].Longitude, SizeOf(Single)); Plain.ReadBuffer(NewCities[K].Latitude, SizeOf(Single)); Plain.ReadBuffer(NewCities[K].Population, SizeOf(Integer)) end;
      WorldShapes := NewWorld; CountryShapes := NewCountries; Cities := NewCities;
    finally Plain.Free; Compressed.Free; Builder.Free end;
  finally TMonitor.Exit(DataLock) end;
end;

function NimbusWorldMapShapes: TArray<TNimbusMapShape>;
begin EnsureLoaded; Result := WorldShapes end;

function NimbusCountryMapShapes(const Country: string): TArray<TNimbusMapShape>;
var Shape: TNimbusMapShape; List: TList<TNimbusMapShape>;
begin
  EnsureLoaded; List := TList<TNimbusMapShape>.Create;
  try for Shape in CountryShapes do if SameText(Shape.Region, Trim(Country)) then List.Add(Shape); Result := List.ToArray finally List.Free end;
end;

function NimbusCountryMapCities(const Country: string; const MaximumCount, MinimumPopulation: Integer): TArray<TNimbusMapCity>;
var City: TNimbusMapCity; List: TList<TNimbusMapCity>;
begin
  Result := nil; if MaximumCount <= 0 then Exit; EnsureLoaded; List := TList<TNimbusMapCity>.Create;
  try for City in Cities do if SameText(City.Country, Trim(Country)) and (City.Population >= MinimumPopulation) then
    begin List.Add(City); if List.Count >= MaximumCount then Break end; Result := List.ToArray finally List.Free end;
end;

initialization
  DataLock := TObject.Create;
finalization
  DataLock.Free;
end.
