procedure TNimbusFinancialPalette.ApplyTheme(const Palette: TThemePalette);
var Dark: Boolean;
begin
  if Palette = nil then begin ApplyPreset(nftpNimbusDark); Exit end;
  Dark := Palette.IsDark; if Dark then ApplyPreset(nftpNimbusDark) else ApplyPreset(nftpNimbusLight);
  FBackground := Palette.BackColor;
  FPanelBackground := Palette.PanelBackColor;
  if FPanelBackground = 0 then FPanelBackground := NimbusControlBackColor(Palette);
  FBorder := NimbusControlBorderColor(Palette);
  FAxisLine := NimbusControlBorderColor(Palette);
  FGridZero := NimbusControlBorderColor(Palette);
  FAxisText := Palette.MutedForeColor; if FAxisText = 0 then FAxisText := NimbusControlForeColor(Palette);
  FTitleText := NimbusControlForeColor(Palette);
  FSubtitleText := FAxisText;
  FAccent := NimbusAccentColor(Palette);
  FAccent2 := NimbusAccentColor(Palette);
  FLegendBorder := NimbusControlBorderColor(Palette);
  if Dark then FLegendBackground := NimbusColorWithAlpha(FPanelBackground, 190) else FLegendBackground := NimbusColorWithAlpha(FPanelBackground, 232);
  FSelection := Palette.SelectedBackColor; if FSelection = 0 then FSelection := FAccent;
  FSelection := NimbusColorWithAlpha(FSelection, 90);
  FHover := Palette.HoverBackColor; if FHover = 0 then FHover := FAccent;
  FHover := NimbusColorWithAlpha(FHover, 70);
  FSmaLine := FAccent;
  FSmaLineSecondary := FAccent2;
  FSmaLineTertiary := FAxisText;
  FEmaLine := FPositiveText;
  FEmaLineSecondary := FNegativeText;
  FBollingerLine := FAccent;
  FBollingerMiddleLine := FSmaLine;
  FRsiLine := FAccent2;
  FRsiLineSecondary := FAccent;
  FRsiOverboughtLine := FNegativeText;
  FRsiOversoldLine := FPositiveText;
  FRsiOverboughtFill := FNegativeText;
  FRsiOversoldFill := FPositiveText;
  FMacdLine := FAccent;
  FMacdLineSecondary := FAxisText;
  FMacdSignalLine := FAccent2;
  FMacdSignalLineSecondary := FEmaLine;
  FMacdHistogramPositive := FPositiveText;
  FMacdHistogramNegative := FNegativeText;
  FStochasticKLine := FAccent2;
  FStochasticKLineSecondary := FAxisText;
  FStochasticDLine := FAccent;
  FStochasticDLineSecondary := FSubtitleText;
  FStochasticOverboughtLine := FNegativeText;
  FStochasticOversoldLine := FPositiveText;
  FStochasticOverboughtFill := FNegativeText;
  FStochasticOversoldFill := FPositiveText;
  FAtrLine := FEmaLine;
  FAtrLineSecondary := FSmaLine;
  FVwapLine := FBollingerLine;
  FVwapLineSecondary := FSmaLineTertiary;
  FAnnotationLine := FAccent2;
  FAnnotationText := FTitleText;
  FSmaLine := FAccent;
  if Dark then begin FBollingerFill := NimbusColorWithAlpha(FAccent, 34); FAnnotationFill := NimbusColorWithAlpha(FAnnotationLine, 34); FAnnotationPriceRangeFill := NimbusColorWithAlpha(FAccent, 28) end
  else begin FBollingerFill := NimbusColorWithAlpha(FAccent, 28); FAnnotationFill := NimbusColorWithAlpha(FAnnotationLine, 32); FAnnotationPriceRangeFill := NimbusColorWithAlpha(FAccent, 26) end;
  if Assigned(FOnChange) then FOnChange(Self);
end;

