<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{7805CEAC-997A-4239-B37B-02B0A26022DE}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="src\ThemingTest.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\NimbusForms.HexEditor\test\HexEditorTest.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="ThemingTest">
        <MSBuild Projects="src\ThemingTest.dproj"/>
    </Target>
    <Target Name="ThemingTest:Clean">
        <MSBuild Projects="src\ThemingTest.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ThemingTest:Make">
        <MSBuild Projects="src\ThemingTest.dproj" Targets="Make"/>
    </Target>
    <Target Name="HexEditorTest">
        <MSBuild Projects="..\NimbusForms.HexEditor\test\HexEditorTest.dproj"/>
    </Target>
    <Target Name="HexEditorTest:Clean">
        <MSBuild Projects="..\NimbusForms.HexEditor\test\HexEditorTest.dproj" Targets="Clean"/>
    </Target>
    <Target Name="HexEditorTest:Make">
        <MSBuild Projects="..\NimbusForms.HexEditor\test\HexEditorTest.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="ThemingTest;HexEditorTest"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="ThemingTest:Clean;HexEditorTest:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="ThemingTest:Make;HexEditorTest:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
