procedure TMainForm.BuildHexEditor;
var
  LPage, LToolPage, LToolBarPage, LMenuBarPage, LStyledPage, LTreePage, LDatePage, LVirtualPage, LHexPage, LBreadcrumbPage, LTagPage, LStepPage, LAvatarPage, LBadgePage, LColorPage, LColorStandalonePage: TTabSheet;
  LRoot, LGroup, LNode: TThemedTreeNode;
  LDateTitle, LDateTimeTitle, LDateCultureTitle, LDateManualTitle, LDateInfo: TThemedLabel;
  LStyledLabel: TThemedStyledLabel;
  LToolButton: TThemedToolButton;
  LToolBar: TThemedToolBar;
  LMenuBar: TThemedMenuBar;
  LBreadcrumb: TThemedBreadcrumbBar;
  LTagInput: TThemedTagInput;
  LBadge: TThemedBadgeLabel;
  LColorPicker: TThemedIdeColorPicker;
  LColorButton: TThemedIdeColorPickerButton;
  LBadgeIndex: Integer;
  LBadgeX: Integer;
  LAvatar: TThemedAvatar;
  LAvatarTitle: TThemedLabel;
  LAvatarIndex: Integer;
  LAvatarFiles: TStringList;
  LAvatarSearch: TSearchRec;
  LAvatarDir: string;
  LAvatarCandidates: array[0..3] of string;
  LAvatarCandidateIndex: Integer;
  LSplitRoot, LSplitNested, LSplitBottom: TThemedSplitContainer;
  LSplitterHost, LSplitterContent, LSplitterOutput: TThemedPanel;
  LSplitterList: TListView;
  LStandaloneSplitter: TThemedSplitter;
  LSplitLabel: TThemedLabel;
  LRangePicker: TThemedDateRangePicker;
  LIdeRangePicker: TThemedIdeDateRangePicker;
  LIdeRangePage: TTabSheet;
  LRangePage: TTabSheet;
  LRangeTitle: TThemedLabel;
  LStep: TThemedStepIndicator;
  LStepTitle: TThemedLabel;
  LStepButton: TThemedButton;
  LStepButtonIndex: Integer;
  LTagTitle: TThemedLabel;
  LBreadcrumbChild: TThemedBreadcrumbChild;
  LMenuBarItem: TThemedMenuBarItem;
  LMenuImages: TImageList;
  LMenuWidthTitle: TThemedLabel;
  LFileMenu, LEditMenu, LViewMenu, LBuildMenu, LHelpMenu: TThemedPopupMenu;
  LToolSeparator: TThemedSeparator;
  LToolSpacer: TThemedToolBarSpacer;
  LToolLabel: TThemedLabel;
  LToolTextBox: TThemedTextBox;
  LToolComboBox: TThemedComboBox;
  LVirtualColumn: TThemedVirtualListColumn;
begin
  FHexPanel := TThemedPanel.Create(Self);
  FHexPanel.Parent := Self;
  FHexPanel.Align := alClient;
  FHexPanel.ShowBorder := False;
  FHexPanel.PopupMenu := FPopupMenu;

  FTabLabel := TThemedLabel.Create(Self);
  FTabLabel.Parent := FHexPanel;
  FTabLabel.Top := 0;
  FTabLabel.Align := alTop;
  FTabLabel.AutoSize := False;
  FTabLabel.Height := P(36);
  FTabLabel.Layout := tlCenter;
  FTabLabel.Caption := STabControlTitle;
  FTabLabel.Font.Size := 12;
  FTabLabel.Font.Style := [fsBold];

  FTabControl := TThemedTabControl.Create(Self);
  FTabControl.Parent := FHexPanel;
  FTabControl.Align := alClient;
  BuildIDEScrollBarDemo;
  FTabControl.TabHeaderHeight := 32;
  FTabControl.CloseButtonMode := tcbmAll;
  FTabControl.AllowTabReorder := True;
  FTabControl.CloseOnMiddleClick := True;
  FTabControl.TabTextTrimming := tttEllipsis;
  FTabControl.MinimumTabWidth := 72;
  FTabControl.MaximumTabWidth := 170;
  FTabControl.VariableTabWidth := True;
  FTabControl.TabContextMenu := FPopupMenu;
  FTabControl.PopupMenu := FPopupMenu;
  FTabControl.OnChange := TabChanged;
  FTabControl.OnTabClosed := TabClosed;
  FTabControl.OnTabReordered := TabReordered;
  LPage := AddTabPage(STabOverview, STabOverviewText);
  FTabControl.SetTabClosable(LPage, False);
  LPage := AddTabPage(SSplitterTab, SSplitterDescription);
  FTabControl.SetTabClosable(LPage, False);
  LSplitterHost := TThemedPanel.Create(LPage); LSplitterHost.Parent := LPage; LSplitterHost.Align := alClient; LSplitterHost.ShowBorder := False;
  LSplitterHost.DisableAlign;
  try
    LSplitterList := TListView.Create(LSplitterHost); LSplitterList.Parent := LSplitterHost;
    LSplitterList.Align := alLeft; LSplitterList.Width := P(220); LSplitterList.Left := 0;
    LSplitterList.ViewStyle := vsReport; LSplitterList.ReadOnly := True;
    LSplitterList.Columns.Add.Caption := SSplitterColumn; LSplitterList.Columns[0].Width := P(180);
    for LBadgeIndex := 1 to 8 do LSplitterList.Items.Add.Caption := Format(SSplitterItem, [LBadgeIndex]);
    LStandaloneSplitter := TThemedSplitter.Create(LSplitterHost); LStandaloneSplitter.Parent := LSplitterHost;
    LStandaloneSplitter.Left := P(220); LStandaloneSplitter.ResizeControl := LSplitterList; LStandaloneSplitter.MinSize := 100;
    LSplitterContent := TThemedPanel.Create(LSplitterHost); LSplitterContent.Parent := LSplitterHost; LSplitterContent.Align := alClient;
  finally LSplitterHost.EnableAlign; end;
  LSplitterContent.DisableAlign;
  try
    LSplitterOutput := TThemedPanel.Create(LSplitterContent); LSplitterOutput.Parent := LSplitterContent;
    LSplitterOutput.Align := alBottom; LSplitterOutput.Height := P(140); LSplitterOutput.Top := P(1000);
    LStandaloneSplitter := TThemedSplitter.Create(LSplitterContent); LStandaloneSplitter.Parent := LSplitterContent;
    LStandaloneSplitter.Align := alBottom; LStandaloneSplitter.Top := P(900); LStandaloneSplitter.ResizeControl := LSplitterOutput;
    LSplitLabel := TThemedLabel.Create(LSplitterOutput); LSplitLabel.Parent := LSplitterOutput;
    LSplitLabel.Align := alClient; LSplitLabel.AutoSize := False; LSplitLabel.Caption := SSplitterOutput;
    LSplitLabel := TThemedLabel.Create(LSplitterContent); LSplitLabel.Parent := LSplitterContent;
    LSplitLabel.Align := alClient; LSplitLabel.AutoSize := False; LSplitLabel.Caption := SSplitterContent;
  finally LSplitterContent.EnableAlign; end;
  LPage := AddTabPage('SplitContainer', 'Nested vertical and horizontal split layouts');
  FTabControl.SetTabClosable(LPage, False);

  LSplitRoot := TThemedSplitContainer.Create(LPage);
  LSplitRoot.Parent := LPage;
  LSplitRoot.Align := alClient;
  LSplitRoot.Orientation := tsoVertical;
  LSplitRoot.FixedPanel := tsfpPanel1;
  LSplitRoot.SplitterWidth := 10;
  LSplitRoot.SplitterStyle := tssGrip;
  LSplitRoot.Panel1MinSize := 130;
  LSplitRoot.Panel2MinSize := 130;
  LSplitRoot.SplitterDistance := P(220);
  LSplitRoot.ShowCollapseButtons := True;

  LSplitLabel := TThemedLabel.Create(LSplitRoot.Panel1);
  LSplitLabel.Parent := LSplitRoot.Panel1;
  LSplitLabel.AutoSize := False;
  LSplitLabel.Height := P(28);
  LSplitLabel.AlignWithMargins := True;
  LSplitLabel.Margins.Left := P(12);
  LSplitLabel.Margins.Top := P(12);
  LSplitLabel.Margins.Right := P(12);
  LSplitLabel.Margins.Bottom := 0;
  LSplitLabel.Align := alTop;
  LSplitLabel.Caption := 'Explorer';

  LSplitNested := TThemedSplitContainer.Create(LSplitRoot.Panel2);
  LSplitNested.Parent := LSplitRoot.Panel2;
  LSplitNested.Align := alClient;
  LSplitNested.Orientation := tsoHorizontal;
  LSplitNested.SplitterWidth := 9;
  LSplitNested.SplitterStyle := tssGrip;
  LSplitNested.FixedPanel := tsfpPanel2;
  LSplitNested.SplitterDistance := P(290);
  LSplitNested.ShowCollapseButtons := True;

  LSplitLabel := TThemedLabel.Create(LSplitNested.Panel1);
  LSplitLabel.Parent := LSplitNested.Panel1;
  LSplitLabel.AutoSize := False;
  LSplitLabel.Height := P(28);
  LSplitLabel.AlignWithMargins := True;
  LSplitLabel.Margins.Left := P(12);
  LSplitLabel.Margins.Top := P(12);
  LSplitLabel.Margins.Right := P(12);
  LSplitLabel.Margins.Bottom := 0;
  LSplitLabel.Align := alTop;
  LSplitLabel.Caption := 'Editor';

  LSplitBottom := TThemedSplitContainer.Create(LSplitNested.Panel2);
  LSplitBottom.Parent := LSplitNested.Panel2;
  LSplitBottom.Align := alClient;
  LSplitBottom.Orientation := tsoVertical;
  LSplitBottom.SplitterWidth := 9;
  LSplitBottom.SplitterStyle := tssSubtle;
  LSplitBottom.SplitterDistance := P(360);

  LSplitLabel := TThemedLabel.Create(LSplitBottom.Panel1);
  LSplitLabel.Parent := LSplitBottom.Panel1;
  LSplitLabel.AutoSize := False;
  LSplitLabel.Height := P(28);
  LSplitLabel.AlignWithMargins := True;
  LSplitLabel.Margins.Left := P(12);
  LSplitLabel.Margins.Top := P(12);
  LSplitLabel.Margins.Right := P(12);
  LSplitLabel.Margins.Bottom := 0;
  LSplitLabel.Align := alTop;
  LSplitLabel.Caption := 'Output';

  LSplitLabel := TThemedLabel.Create(LSplitBottom.Panel2);
  LSplitLabel.Parent := LSplitBottom.Panel2;
  LSplitLabel.AutoSize := False;
  LSplitLabel.Height := P(28);
  LSplitLabel.AlignWithMargins := True;
  LSplitLabel.Margins.Left := P(12);
  LSplitLabel.Margins.Top := P(12);
  LSplitLabel.Margins.Right := P(12);
  LSplitLabel.Margins.Bottom := 0;
  LSplitLabel.Align := alTop;
  LSplitLabel.Caption := 'Properties';

