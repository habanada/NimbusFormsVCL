    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <SanitizedProjectName>NimbusCodeEditorStudio</SanitizedProjectName>
    <DCC_UnitSearchPath>..\..\NimbusForms.Controls\src;..\..\NimbusForms.Theming\src;..;Shared;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
    <DCC_ExeOutput>..\..\bin</DCC_ExeOutput>
    <DCC_DcuOutput>..\..\bin\obj\$(Platform)\$(Config)\NimbusCodeEditorStudio</DCC_DcuOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <DCC_Define>DEBUG;FRAMEWORK_VCL;$(DCC_Define)</DCC_Define>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_DebugInformation>2</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
    <BT_BuildType>Debug</BT_BuildType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2)'!=''">
