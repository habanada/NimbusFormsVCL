var
  Demo: TDemoHostForm;
  Tabs: TThemedTabControl;
begin
  Application.Initialize; Application.Title := SApplicationTitle; Application.MainFormOnTaskbar := True;
  Demo := TDemoHostForm.CreateNew(nil);
  try
    Tabs := TThemedTabControl.Create(Demo); Tabs.Parent := Demo.Body; Tabs.Align := alClient;
    AddNimbusChartsDemo(Tabs); AddRemainingNimbusChartsDemo(Tabs); AddNimbusMiniGallery(Tabs); AddNimbusMicroGallery(Tabs); AddNimbusDashboardGallery(Tabs); AddNimbusPerformanceGallery(Tabs);
    ThemeManager.ApplyCurrent(Demo); Demo.ShowModal;
  finally Demo.Free; end;
end.
